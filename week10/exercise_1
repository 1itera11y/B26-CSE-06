import java.util.ArrayList;

public abstract class Creature {
    private String name;
    private boolean isAlive;
    public Creature(String name, boolean isAlive) {    
        this.name = null;
        this.isAlive = false;
    }
    public Creature(boolean isAlive) {
        this.isAlive = false;
    }
    public abstract void bear(String name);
    public abstract void die();
    public void shoutName() {
        if (name != null) {
            System.out.println(name);
        }
        else {
            System.out.println("Error");
        }
    }
    public void setter(String name) {
        this.name = name;
    }
    public String getter() {
        String name = this.name;
        return name;
    }
}
class Alien extends Creature {
    public Alien(String name, boolean isAlive) {
        super(name,isAlive);
    }
    public Alien(boolean isAlive) {
        super(isAlive);
    }
    @Override 
    public void bear(String name) {
        setter(name);
        System.out.println("The Alien " + name + " was born");
    }
    @Override 
    public void die() {
        String name = getter();
        System.out.println("The Alien " + name + " has died");
    }
}
