class AbstractClassDemonstration {
    public static void main(String args[]) {
        Creature alien = new Alien(true);
        alien.bear("slien");
        alien.die();
        Creature human = new Human(true);
        Creature dog = new Dog(true);
        ArrayList<Creature> creatures = new ArrayList<>();

        creatures.add(alien);
        creatures.add(human);
        creatures.add(dog);
        String[] arrayofnames = {"$#*(@#*$),$*%7#(KFP$)#($*&%","Max","dog"};
        for (int i = 0, j = 0; i < 3; i++,j++) {
            creatures.get(i).bear(arrayofnames[j]);
            creatures.get(i).die();
        }
    }
}
