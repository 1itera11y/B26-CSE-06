
// Rover mission controller

#include <stdio.h> // a.akhmetzianov@innopolis.university
#include <string.h>
#include <math.h>
#include <stdlib.h> 
#define IDLE 0
#define ACTIVE 1
#define SAFE 2
#define MILLION 1000000
FILE *input;
FILE *output;

int coordinatelim = 0; // L, constraint
int numofcom = 0; // N, number of commands

struct Rover { // Rover characteristics
    int x,y;
    int battery,maxbattery,heat;
    int cargo,cargocap;
    int mode;
    int distance;
    int rejected,accepted,restores;
    int checkpoint_valid;
    int checkpoint[5];
};

// command START sets rover mode to active
void start(struct Rover *r) {
    if (r -> mode == ACTIVE) {
        fputs("R -1\n", output);
        r -> rejected++;
    }
    else if (r -> mode == SAFE) {
        fputs("R -2\n", output);
        r -> rejected++;
    }
    else if (r -> battery < 5) {
        fputs("R -3\n", output);
        r -> rejected++;

    }
    else if (r -> heat >= 80) {
        fputs("R -4\n", output);
        r -> rejected++;
    }
    else {
        fputs("R 1\n", output);
        r -> mode = ACTIVE;
        r -> accepted++;
    }

}

// command STOP sets rover mode to idle.
void stop(struct Rover *r) {
    if (r -> mode != ACTIVE) {
        fputs("R -5\n", output);
        r -> rejected++;
    }
    else {
        fputs("R 2\n", output);
        r -> mode = IDLE;
        r -> accepted++;
    }
}

// command MOVE moves the rover to dx dy. Also, it calculates distance(d), energy cost,
void move(struct Rover *r) { // current heat, and current battery. After that, mode will be SAFE.
    int dx = 0;
    int dy = 0;
    fscanf(input, "%d%d", &dx, &dy);
    int energycost = 0;
    int d = (abs(dx) +abs(dy)); // the Manhattan distance
    energycost = d* (2 + r -> cargo); // energy cost
    
    if (r -> mode != ACTIVE) {
        fputs("R -10\n", output);
        r -> rejected++;
    }
    else if (dx == 0 && dy == 0) {
        fputs("R -11\n", output);
        r -> rejected++;
    }
    else if (abs(r -> x + dx) > coordinatelim || abs(r -> y + dy) > coordinatelim) {
        fputs("R -12\n", output);
        r -> rejected++;
    }
    else if (r -> battery < energycost) {
        fputs("R -13\n",output);
        r -> rejected++;
    }
    else {
        fputs("R 3\n", output);
        r -> heat += d + r -> cargo;
        r -> x += dx;
        r -> y += dy;
        r -> distance += d;
        r -> battery -= energycost;
        r -> accepted++;
        if (r -> heat >= 100 || r -> battery == 0) {
            r -> mode = SAFE;
        }
    }
}

// command LOAD 
void load(struct Rover *r) {
    int w = 0;
    fscanf(input, "%d", &w);
    if (r -> mode != IDLE) {
        fputs("R -20\n", output);
        r -> rejected++;
    }
    else if (r -> x != 0 || r -> y != 0) {
        fputs("R -21\n", output);
        r -> rejected++;
    }
    else if (w <= 0) {
        fputs("R -22\n", output);
        r -> rejected++;
    }
    else if (r -> cargo + w > r -> cargocap) {
        fputs("R -23\n", output);
        r -> rejected++;
    }
    else {
        fputs("R 4\n", output);
        r -> cargo += w;
        r -> accepted++;
    }
}

// command UNLOAD substracts w from cargo. The rover unloads w cargo.
void unload(struct Rover *r) {
    int w = 0;
    fscanf(input, "%d", &w);
    if (r -> mode == ACTIVE) {
        fputs("R -30\n", output);
        r -> rejected++;
    }
    else if (w <= 0) {
        fputs("R -31\n", output);
        r -> rejected++;
    }
    else if (w > r -> cargo) {
        fputs("R -32\n", output);
        r -> rejected++;
    }
    else {
        fputs("R 5\n", output);
        r -> cargo -= w;
        r -> accepted++;
    }
}

// command COOL sets the rover`s mode to idle if heat < 80 and battery > 0
void cool(struct Rover *r) { // and decreases the rover`s heat
    if (r -> mode == ACTIVE) {
        fputs("R -40\n", output);
        r -> rejected++;
    }
    else {
        r -> heat = fmax(0, r -> heat -25);
        if (r -> mode == SAFE && (r -> heat < 80 && r -> battery > 0)) {
            r -> mode = IDLE;
        }
        fputs("R 6\n", output);
        r -> accepted++;
    }
}

// command RECHARGE increases the rover`s battery and 
void recharge(struct Rover *r) { // sets the rover`s mode to idle if heat < 80 and battery > 0
    int amount = 0;
    fscanf(input, "%d", &amount);
    if (r -> mode == ACTIVE) {
        fputs("R -50\n",output);
        r -> rejected++;
    }
    else if (r -> x != 0 || r -> y != 0) {
        fputs("R -51\n", output);
        r -> rejected++;
    }
    else if (amount <= 0) {
        fputs("R -52\n", output);
        r -> rejected++;
    }
    else {
        fputs("R 7\n", output);
        r -> battery = fmin(r -> maxbattery, r -> battery + amount);
        if (r -> mode == SAFE && (r -> heat < 80 && r -> battery > 0)) {
            r -> mode = IDLE;
        }
        r -> accepted++;
    }
}

// command SAVE saves the rover`s x, y, battery, heat, and cargo into integer array (checkpoint[5])
void save(struct Rover *r) { // and sets checkpoint flag to 1
    if (r -> mode != IDLE) {
        fputs("R -60\n", output);
        r -> rejected++;
    }
    else {
        r -> checkpoint[0] = r -> x;
        r -> checkpoint[1] = r -> y;
        r -> checkpoint[2] = r -> battery;
        r -> checkpoint[3] = r -> heat;
        r -> checkpoint[4] = r -> cargo;
        r -> checkpoint_valid = 1;
        fputs("R 8\n", output);
        r -> accepted++;
    }
}

// command RESTORE changes current rover`s values of x, y, battery, heat, and cargo 
void restore(struct Rover *r) { // to the values from checkpoint[5] for x, y, battery, heat, and cargo
    if (r -> mode == ACTIVE) {
        fputs("R -70\n", output);
        r -> rejected++;
    }
    else if (r -> checkpoint_valid == 0) {
        fputs("R -71\n", output);
        r -> rejected++;
    }
    else {
        r -> x = r -> checkpoint[0];
        r -> y = r -> checkpoint[1];
        r -> battery = r -> checkpoint[2];
        r -> heat = r -> checkpoint[3];
        r -> cargo = r -> checkpoint[4];
        r -> mode = IDLE;
        fputs("R 9\n", output);
        r -> restores++;
        r -> accepted++;
    }
}

// command STATUS prints current values of the rover`s charachteristics except maxbattery and cargocap
void status(struct Rover *r) {
    fprintf(output, "S %d %d %d %d %d %d %d %d %d %d %d\n",
    r -> x, r -> y, r -> battery, r -> heat, r -> cargo,
    r -> mode, r -> distance, r -> accepted,
    r -> rejected, r -> restores, r -> checkpoint_valid);
}

// main function
int main() {
    struct Rover r;
    r.x = 0; r.y = 0; // in the beginning of the programm, all values are equal to 0
    r.battery = 0; r.heat = 0;
    r.cargo = 0;
    r.mode = 0;
    r.rejected = 0; r.accepted = 0; r.restores = 0;
    r.checkpoint_valid = 0;
    r.distance = 0;

    // pointers to input.txt and output.txt
    input = fopen("input.txt", "r");
    output = fopen("output.txt", "w");
    if (input == NULL || input == NULL) {
        return -1;
    }

    fscanf(input, "%d%d%d%d%d", &r.battery, &r.maxbattery, &r.heat ,&r.cargocap, &coordinatelim);
    fscanf(input, "%d", &numofcom);

    //checking the constraints
    if (r.battery < 1) {
        return -1;
    }
    else if (r.battery > r.maxbattery || r.maxbattery > MILLION) {
        return -1;
    }
    else if (r.heat < 0 || r.heat >= 100) {
        return -1;
    }
    else if (r.cargocap < 0 || r.cargocap > 20) {
        return -1;
    }
    else if (coordinatelim < 1 || coordinatelim > 1000) {
        return -1;
    }
    else if (numofcom < 1 || numofcom > 10000) {
        return -1;
    }
    // end of checking

    // determining each string of input.txt
    for (int i = 0; i < numofcom; i++) {
        char word[9];
        fscanf(input, "%8s", word);
        if (strcmp(word, "START") == 0) {
            start(&r);
        } 
        else if (strcmp(word, "STOP") == 0) {
            stop(&r);
        }
        else if (strcmp(word, "MOVE") == 0) {
            move(&r);
        }
        else if (strcmp(word, "LOAD") == 0) {
            load(&r);
        }
        else if (strcmp(word, "UNLOAD") == 0) {
            unload(&r);
        }
        else if (strcmp(word, "COOL") == 0) {
            cool(&r);
        }
        else if (strcmp(word, "RECHARGE") == 0) {
            recharge(&r);
        }
        else if (strcmp(word, "SAVE") == 0) {
            save(&r);
        }
        else if (strcmp(word, "RESTORE") == 0) {
            restore(&r);
        }
        else if (strcmp(word, "STATUS") == 0) {
            status(&r);
        }
        else {
            return -1;
        }
    }

    //the last string in output.txt that includes the rover`s characteristics
    fprintf(output, "F %d %d %d %d %d %d %d %d %d %d %d\n",
    r.x, r.y, r.battery, r.heat, r.cargo,
    r.mode, r.distance, r.accepted,
    r.rejected, r.restores, r.checkpoint_valid);

    fclose(input);
    fclose(output);
    return 0;
}
