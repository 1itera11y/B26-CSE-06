import java.util.Scanner;

public class Time {
    int h;
    int m;
    int s;
    public void calcdif(Time other) {
        int a1 = this.h*60*60 + this.m*60 + this.s;
        int a2 = other.h*60*60 + other.m*60 + other.s;
        int dif = Math.abs(a1 - a2);
        int sec = dif % 60;
        int min = (dif % 3600) / 60;
        int hou = dif / 3600;
        System.out.printf("The difference is: %02d:%02d:%02d", hou,min,sec);
    }
    public static void main(String[] args) {
        Time time1 = new Time();
        System.out.println("Enter for the first time: *hours* *minutes* *seconds*");
        Scanner sc = new Scanner(System.in);
        time1.h = sc.nextInt();
        time1.m = sc.nextInt();
        time1.s = sc.nextInt();
        
        System.out.println("Enter for the second time: *hours* *minutes* *seconds*");
        Time time2 = new Time();
        time2.h = sc.nextInt();
        time2.m = sc.nextInt();
        time2.s = sc.nextInt();
        time1.calcdif(time2);
    }
}
